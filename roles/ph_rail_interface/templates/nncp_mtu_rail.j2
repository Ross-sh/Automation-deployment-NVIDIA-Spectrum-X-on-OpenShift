---
apiVersion: nmstate.io/v1
kind: NodeNetworkConfigurationPolicy
metadata:
  name: nncp-mtu-{{ rail | replace('_', '-') }}
spec:
  nodeSelector:
    node-role.kubernetes.io/worker: ''
  desiredState:
    interfaces:
    - name: {{ rail }}
      description: mtu 9216 {{ rail }}
      type: ethernet
      state: up
      mtu: 9216
