---
- name: Ensure destination directory exists
  ansible.builtin.file:
    path: files
    state: directory
    mode: '0755'

- name: Generate NMState NodeNetworkConfigurationPolicies template
  ansible.builtin.template:
    src: templates/nncp_mtu_tail.j2
    dest: files/nncp-mtu-rails.yml
    mode: '0644'

- name: Apply NNCP manifests to the cluster
  kubernetes.core.k8s:
    kubeconfig: "{{ k8s_kubeconfig }}"
    host: "{{ ocp_api_url }}"
    src: files/nncp-mtu-rails.yml
    state: present
